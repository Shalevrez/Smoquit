# ─────────────────────────────────────────────────────────────────────────
#  Smoquit — cache rules (Cloudflare Pages reads this file natively;
#  so does Netlify, with the same syntax, if we ever move back).
#
#  Two different kinds of file live here, and they need opposite treatment:
#
#   • assets/  — the built bundle. Its filename contains a hash of its own
#     contents, so a changed file always arrives under a NEW name. It can
#     safely be cached forever; there is no such thing as a stale one.
#
#   • the runtime files at the root — config.js, version.js,
#     storage-health.js, index.html. These keep the same name forever and
#     are edited in place. Caching them is what makes a deploy look like it
#     "did nothing": you upload a new version and the browser keeps showing
#     the old one. Worst of all for version.js, whose entire job is telling
#     you the truth about which build you are looking at.
#
#  "no-cache" does not mean "never store it" — it means "always check with
#  the server first". A revalidation of a 1 KB file costs nothing.
# ─────────────────────────────────────────────────────────────────────────

# Content-hashed build output — safe to keep forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Edited in place, so always revalidate.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/config.js
  Cache-Control: public, max-age=0, must-revalidate

/version.js
  Cache-Control: public, max-age=0, must-revalidate

/storage-health.js
  Cache-Control: public, max-age=0, must-revalidate

# The service worker. Revalidating this one matters more than any of the
# others: it outlives the page that installed it, so a cached copy is a
# fixed bug that never reaches the phone it was fixed for. Browsers already
# bypass the cache for it on most updates, but "already" is not a plan.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Read once at install time and then rarely, but it decides the name and the
# icon on somebody's home screen, so a stale one is visible for months.
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Content-hashed like the bundle in spirit — they never change under the
# same name — but they are hand-placed, so a week is the honest compromise.
/icon-192.png
  Cache-Control: public, max-age=604800

/icon-512.png
  Cache-Control: public, max-age=604800

/icon-maskable-512.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
